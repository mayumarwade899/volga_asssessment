# Application settings
TRANSCRIPTION_APP_NAME=Volga Transcription Service
TRANSCRIPTION_ENVIRONMENT=development
TRANSCRIPTION_HOST=127.0.0.1
TRANSCRIPTION_PORT=8000

# Local Faster-Whisper settings. Model files are downloaded on first use and
# cached locally by Faster-Whisper's model-loading dependencies.
TRANSCRIPTION_MODEL_SIZE=base
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8

# Upload policy.
TRANSCRIPTION_MAX_UPLOAD_SIZE_MB=500
TRANSCRIPTION_TEMP_DIR=
